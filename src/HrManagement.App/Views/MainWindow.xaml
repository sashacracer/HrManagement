<Window x:Class="HrManagement.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление кадрами"
        Width="1320"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="Foreground" Value="#526174" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E4E9F1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#EDF0F5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,20,26">
                    <Border Width="46" Height="46" Background="#3C5B88" CornerRadius="12" HorizontalAlignment="Left">
                        <TextBlock Text="УК" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,14,0,0" Text="Управление кадрами" Foreground="White"
                               FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="Кадровая информационная система"
                               Foreground="#9EB1CD" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="▣   Обзор" Style="{StaticResource NavButton}" Click="Dashboard_Click" />
                    <Button Content="♙   Сотрудники" Style="{StaticResource NavButton}" Click="Employees_Click" />
                    <Button Content="▤   Отсутствия" Style="{StaticResource NavButton}" Click="Absences_Click" />
                    <Button Content="▥   Отчёты" Style="{StaticResource NavButton}" Click="Reports_Click" />
                    <Separator Margin="24,18" Background="#476187" />
                    <Button Content="⚙   Справочники" Style="{StaticResource NavButton}" IsEnabled="False" />
                    <Button Content="☷   Журнал действий" Style="{StaticResource NavButton}" IsEnabled="False" />
                </StackPanel>

                <Border Grid.Row="2" Margin="18" Padding="14" Background="#1D3154" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding CurrentRole}" Foreground="#9EB1CD" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E7EBF1" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="22" FontWeight="SemiBold"
                               Foreground="#243B64" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#EDF4FC" Padding="12,7" CornerRadius="16">
                            <TextBlock Text="●  База данных подключена" Foreground="#24755B" FontSize="12" />
                        </Border>
                        <TextBlock Margin="18,0,0,0" Text="02.11.2026" Foreground="#6C788B" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="ContentTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <TextBlock Text="Добрый день!" FontSize="28" FontWeight="SemiBold" Foreground="#243B64" />
                            <TextBlock Margin="0,6,0,24" Text="Краткая сводка по персоналу организации" Foreground="#6B778C" FontSize="14" />

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Сотрудники" Foreground="#6B778C" />
                                        <TextBlock Margin="0,10,0,0" Text="{Binding EmployeeCount}" FontSize="32" FontWeight="Bold" Foreground="#243B64" />
                                        <TextBlock Text="активных карточек" Foreground="#8090A5" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Подразделения" Foreground="#6B778C" />
                                        <TextBlock Margin="0,10,0,0" Text="{Binding DepartmentCount}" FontSize="32" FontWeight="Bold" Foreground="#2E7DDB" />
                                        <TextBlock Text="в структуре" Foreground="#8090A5" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Сегодня отсутствуют" Foreground="#6B778C" />
                                        <TextBlock Margin="0,10,0,0" Text="{Binding AbsenceCount}" FontSize="32" FontWeight="Bold" Foreground="#D98A35" />
                                        <TextBlock Text="по документам" Foreground="#8090A5" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Контрольные даты" Foreground="#6B778C" />
                                        <TextBlock Margin="0,10,0,0" Text="3" FontSize="32" FontWeight="Bold" Foreground="#7B61C8" />
                                        <TextBlock Text="в ближайшие 30 дней" Foreground="#8090A5" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel>
                                        <Grid Margin="22,20,22,12">
                                            <TextBlock Text="Сотрудники" FontSize="17" FontWeight="SemiBold" Foreground="#243B64" />
                                            <Button Content="Открыть раздел" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                                                    Padding="12,7" Click="Employees_Click" />
                                        </Grid>
                                        <DataGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                                                  MaxHeight="330" RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Таб. №" Binding="{Binding PersonnelNumber}" Width="80" />
                                                <DataGridTextColumn Header="Сотрудник" Binding="{Binding FullName}" Width="*" />
                                                <DataGridTextColumn Header="Подразделение" Binding="{Binding Department}" Width="150" />
                                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Background="#243B64">
                                    <StackPanel>
                                        <TextBlock Text="Ближайшие события" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                                        <Border Margin="0,18,0,0" Padding="12" Background="#304A74" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="04–06 ноября" Foreground="#9FC4F2" FontSize="12" />
                                                <TextBlock Margin="0,4,0,0" Text="Командировка — Д. А. Орлов" Foreground="White" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,10,0,0" Padding="12" Background="#304A74" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="09–22 ноября" Foreground="#9FC4F2" FontSize="12" />
                                                <TextBlock Margin="0,4,0,0" Text="Отпуск — М. С. Волков" Foreground="White" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="330" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" ToolTip="ФИО, табельный номер или подразделение" />
                                <Button Margin="10,0,0,0" Content="Найти" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Margin="10,0,0,0" Content="Сбросить" Click="ResetSearch_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Изменить" Click="EditEmployee_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="Оформить увольнение" Command="{Binding DismissCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="+  Новый сотрудник" Click="AddEmployee_Click" Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Таб. №" Binding="{Binding PersonnelNumber}" Width="80" />
                                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding FullName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Подразделение" Binding="{Binding Department}" Width="*" />
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*" />
                                    <DataGridTextColumn Header="Дата приёма" Binding="{Binding HireDate}" Width="110" />
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Календарь отсутствий" FontSize="20" FontWeight="SemiBold" Foreground="#243B64" />
                            <Button Content="+  Зарегистрировать отсутствие" HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="False" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ноябрь 2026" FontSize="18" FontWeight="SemiBold" Foreground="#243B64" />
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="М. С. Волков" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="38" Background="#EAF3FD" CornerRadius="7">
                                        <Grid>
                                            <Border Margin="240,4,120,4" Background="#62A2E8" CornerRadius="6" />
                                            <TextBlock Text="Ежегодный отпуск · 09–22.11" Foreground="#234A75" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Д. А. Орлов" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Height="38" Background="#FDF3E7" CornerRadius="7">
                                        <Grid>
                                            <Border Margin="90,4,490,4" Background="#E5A45D" CornerRadius="6" />
                                            <TextBlock Text="Командировка · 04–06.11" Foreground="#75461C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,30,0,0" Text="Пересечения периодов контролируются до сохранения кадрового документа."
                                           Foreground="#6B778C" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <Grid>
                                <TextBlock Text="Кадровая аналитика" FontSize="20" FontWeight="SemiBold" Foreground="#243B64" />
                                <Button Content="Экспорт в CSV" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                            </Grid>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Численность по подразделениям" FontWeight="SemiBold" FontSize="16" Foreground="#243B64" />
                                        <TextBlock Margin="0,20,0,5" Text="Отдел кадров" Foreground="#536174" />
                                        <ProgressBar Height="16" Maximum="5" Value="1" Foreground="#2E7DDB" />
                                        <TextBlock Margin="0,16,0,5" Text="Информационные технологии" Foreground="#536174" />
                                        <ProgressBar Height="16" Maximum="5" Value="1" Foreground="#5C9CE6" />
                                        <TextBlock Margin="0,16,0,5" Text="Финансовый отдел" Foreground="#536174" />
                                        <ProgressBar Height="16" Maximum="5" Value="1" Foreground="#7B61C8" />
                                        <TextBlock Margin="0,16,0,5" Text="Отдел продаж" Foreground="#536174" />
                                        <ProgressBar Height="16" Maximum="5" Value="1" Foreground="#D98A35" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Движение персонала" FontWeight="SemiBold" FontSize="16" Foreground="#243B64" />
                                        <Grid Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#EDF7F2" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="Принято" Foreground="#527565" />
                                                    <TextBlock Text="2" FontSize="32" FontWeight="Bold" Foreground="#2F8B64" />
                                                    <TextBlock Text="за 2026 год" Foreground="#71887D" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#FDF0F0" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Уволено" Foreground="#835D5D" />
                                                    <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="#BC5555" />
                                                    <TextBlock Text="за 2026 год" Foreground="#907777" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="0,28,0,0" Text="Средняя численность подразделения" Foreground="#6B778C" />
                                        <TextBlock Text="1,0 сотрудника" FontSize="22" FontWeight="SemiBold" Foreground="#243B64" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
