<Window x:Class="HrManagement.App.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5EAF1" BorderThickness="0,0,0,1">
            <StackPanel Margin="28,0" VerticalAlignment="Center">
                <TextBlock Text="Карточка сотрудника" FontSize="22" FontWeight="SemiBold" Foreground="#243B64" />
                <TextBlock Text="Основные данные, должность и подразделение" Foreground="#6B778C" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Margin="28,22" Padding="24" Background="White" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,12,16">
                        <TextBlock Text="Табельный номер *" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding PersonnelNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Дата приёма *" FontWeight="SemiBold" Foreground="#40506A" />
                        <DatePicker Margin="0,7,0,0" SelectedDate="{Binding HireDate}" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,12,16">
                        <TextBlock Text="Фамилия *" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Имя *" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,12,16">
                        <TextBlock Text="Отчество" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Дата рождения *" FontWeight="SemiBold" Foreground="#40506A" />
                        <DatePicker Margin="0,7,0,0" SelectedDate="{Binding BirthDate}" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,12,16">
                        <TextBlock Text="Подразделение *" FontWeight="SemiBold" Foreground="#40506A" />
                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Departments}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Employee.DepartmentId}" Padding="8" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Должность *" FontWeight="SemiBold" Foreground="#40506A" />
                        <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Positions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding Employee.PositionId}" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,12,16">
                        <TextBlock Text="Электронная почта" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="12,0,0,16">
                        <TextBlock Text="Телефон" FontWeight="SemiBold" Foreground="#40506A" />
                        <TextBox Margin="0,7,0,0" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <Border Grid.Row="5" Grid.ColumnSpan="2" Background="#EDF4FC" CornerRadius="8" Padding="14">
                        <TextBlock Text="Кадровая операция будет сохранена в журнале действий пользователя."
                                   Foreground="#41658E" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5EAF1" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="28,0">
                <Button Content="Отмена" Width="110" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button Content="Сохранить" Width="120" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
