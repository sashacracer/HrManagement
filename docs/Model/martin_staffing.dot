digraph HR {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.38", ranksep="0.8", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=13];
edge [dir=both, arrowhead="crowodot", arrowsize=0.9, penwidth=1.4, color="#334155", fontname="Arial", fontsize=10];
"Departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Departments</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Подразделения</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ParentDepartmentId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Name</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD></TR></TABLE>>];
"Positions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Positions</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Должности</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Name</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SalaryRate</TD></TR></TABLE>>];
"StaffUnits" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>StaffUnits</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Штатные единицы</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PositionId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Quantity</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SalaryMin</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">SalaryMax</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveFrom</TD></TR></TABLE>>];
"Employees" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Employees</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Сотрудники</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PositionId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PersonnelNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LastName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FirstName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MiddleName ?</TD></TR></TABLE>>];
"EmploymentContracts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>EmploymentContracts</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Трудовые договоры</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">StaffUnitId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ContractNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ContractDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StartDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EndDate ?</TD></TR></TABLE>>];
"PersonnelOrders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>PersonnelOrders</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Кадровые приказы</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ContractId ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CreatedByUserId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderType</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveDate</TD></TR></TABLE>>];
"Departments" -> "Departments" [arrowtail="teeodot", tooltip="Departments.ParentDepartmentId -> Departments.Id"];
"Departments" -> "StaffUnits" [arrowtail="teetee", tooltip="StaffUnits.DepartmentId -> Departments.Id"];
"Positions" -> "StaffUnits" [arrowtail="teetee", tooltip="StaffUnits.PositionId -> Positions.Id"];
"Departments" -> "Employees" [arrowtail="teetee", tooltip="Employees.DepartmentId -> Departments.Id"];
"Positions" -> "Employees" [arrowtail="teetee", tooltip="Employees.PositionId -> Positions.Id"];
"Employees" -> "EmploymentContracts" [arrowtail="teetee", tooltip="EmploymentContracts.EmployeeId -> Employees.Id"];
"StaffUnits" -> "EmploymentContracts" [arrowtail="teetee", tooltip="EmploymentContracts.StaffUnitId -> StaffUnits.Id"];
"Employees" -> "PersonnelOrders" [arrowtail="teetee", tooltip="PersonnelOrders.EmployeeId -> Employees.Id"];
"EmploymentContracts" -> "PersonnelOrders" [arrowtail="teeodot", tooltip="PersonnelOrders.ContractId -> EmploymentContracts.Id"];
}