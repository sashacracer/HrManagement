digraph HR {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.38", ranksep="0.8", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=13];
edge [dir=both, arrowhead="crowodot", arrowsize=0.9, penwidth=1.4, color="#334155", fontname="Arial", fontsize=10];
"Employees" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Employees</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Сотрудники</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PositionId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PersonnelNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LastName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FirstName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MiddleName ?</TD></TR></TABLE>>];
"UserAccounts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>UserAccounts</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Учётные записи</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Login</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PasswordHash</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PasswordSalt</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DisplayName</TD></TR></TABLE>>];
"Roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Roles</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Роли доступа</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Name</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Description ?</TD></TR></TABLE>>];
"UserRoles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>UserRoles</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Назначения ролей</FONT></TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">UserAccountId</TD></TR><TR><TD ALIGN="LEFT">PK, FK</TD><TD ALIGN="LEFT">RoleId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">AssignedAt</TD></TR></TABLE>>];
"AuditEntries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>AuditEntries</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Журнал действий</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">UserAccountId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Action</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EntityName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EntityId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">CreatedAt</TD></TR></TABLE>>];
"Employees" -> "UserAccounts" [arrowtail="teeodot", tooltip="UserAccounts.EmployeeId -> Employees.Id"];
"UserAccounts" -> "UserRoles" [arrowtail="teetee", tooltip="UserRoles.UserAccountId -> UserAccounts.Id"];
"Roles" -> "UserRoles" [arrowtail="teetee", tooltip="UserRoles.RoleId -> Roles.Id"];
"UserAccounts" -> "AuditEntries" [arrowtail="teeodot", tooltip="AuditEntries.UserAccountId -> UserAccounts.Id"];
}