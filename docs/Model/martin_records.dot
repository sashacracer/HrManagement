digraph HR {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.38", ranksep="0.8", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=13];
edge [dir=both, arrowhead="crowodot", arrowsize=0.9, penwidth=1.4, color="#334155", fontname="Arial", fontsize=10];
"Employees" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Employees</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Сотрудники</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">DepartmentId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">PositionId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">PersonnelNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">LastName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">FirstName</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">MiddleName ?</TD></TR></TABLE>>];
"PersonnelOrders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>PersonnelOrders</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Кадровые приказы</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">ContractId ?</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">CreatedByUserId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderNumber</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">OrderType</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EffectiveDate</TD></TR></TABLE>>];
"LeaveTypes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>LeaveTypes</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Виды отпусков</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Code</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Name</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IsPaid</TD></TR></TABLE>>];
"Leaves" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Leaves</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Отпуска</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">LeaveTypeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">OrderId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StartDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EndDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">CalendarDays</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Status</TD></TR></TABLE>>];
"Absences" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>Absences</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Фактические отсутствия</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">LeaveId ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Type</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">StartDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EndDate</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DocumentNumber ?</TD></TR></TABLE>>];
"EmployeeDocuments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>EmployeeDocuments</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Документы сотрудников</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">DocumentType</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Series ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Number</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">IssueDate ?</TD></TR></TABLE>>];
"EducationRecords" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1f2937"><TR><TD COLSPAN="2" BGCOLOR="#e8eef5"><B>EducationRecords</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">Образование и квалификация</FONT></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">Id</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">EmployeeId</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">EducationLevel</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Institution</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Specialty</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">Qualification ?</TD></TR></TABLE>>];
"Employees" -> "PersonnelOrders" [arrowtail="teetee", tooltip="PersonnelOrders.EmployeeId -> Employees.Id"];
"Employees" -> "Leaves" [arrowtail="teetee", tooltip="Leaves.EmployeeId -> Employees.Id"];
"LeaveTypes" -> "Leaves" [arrowtail="teetee", tooltip="Leaves.LeaveTypeId -> LeaveTypes.Id"];
"PersonnelOrders" -> "Leaves" [arrowtail="teeodot", tooltip="Leaves.OrderId -> PersonnelOrders.Id"];
"Employees" -> "Absences" [arrowtail="teetee", tooltip="Absences.EmployeeId -> Employees.Id"];
"Leaves" -> "Absences" [arrowtail="teeodot", tooltip="Absences.LeaveId -> Leaves.Id"];
"Employees" -> "EmployeeDocuments" [arrowtail="teetee", tooltip="EmployeeDocuments.EmployeeId -> Employees.Id"];
"Employees" -> "EducationRecords" [arrowtail="teetee", tooltip="EducationRecords.EmployeeId -> Employees.Id"];
}